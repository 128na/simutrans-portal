<IfModule mod_rewrite.c>
    # disable bots
    RewriteCond %{HTTP_USER_AGENT} (SentryUptimeBot) [NC]
    RewriteRule .* - [F,L]
    # disable cloud attack

    <IfModule mod_negotiation.c>
        Options -MultiViews -Indexes
    </IfModule>

    RewriteEngine On

    # Uploaded files must never be dispatched to executable handlers.
    RewriteRule ^storage/.*\.(?:php[0-9]*|phtml|pht|phar|cgi|pl|py|sh|shtml)(?:[./]|$) - [F,L,NC]

    # 旧URL互換リダイレクト設定
	RewriteBase /
	# category/pak/{size}/none    -> categories/pak/{size}/none
	# category/pak/{size}/{slug}  -> categories/pak/{size}/{slug}
	# category/{type}/{slug}  -> categories/{type}/{slug}
	RewriteRule ^category/(.+)$  /categories/$1 [L,R=301]
	# tag/{tag}   -> tags/{tag}
	RewriteRule ^tag/(.+)$  /tags/$1 [L,R=301]
	# user/{user} -> users/{user}
	RewriteRule ^user/(.+)$  /users/$1 [L,R=301]

    # Handle Authorization Header
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # Redirect Trailing Slashes If Not A Folder...
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_URI} (.+)/$
    RewriteRule ^ %1 [L,R=301]

    # Send Requests To Front Controller...
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ index.php [L]
</IfModule>

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff" "expr=%{REQUEST_URI} =~ m#(?i)^/storage/#"
    Header always set Content-Security-Policy "sandbox; default-src 'none'" "expr=%{REQUEST_URI} =~ m#(?i)^/storage/#"
    Header always set Content-Disposition "attachment" "expr=%{REQUEST_URI} =~ m#(?i)^/storage/# && %{REQUEST_URI} !~ m#(?i)\.(?:avif|bmp|gif|jpe?g|jfif|png|webp)$#"
</IfModule>
